---
import BaseLayout from "../layouts/BaseLayout.astro";
import LandingNav from "../components/landing/LandingNav.astro";
import LandingHero from "../components/landing/LandingHero.astro";
import LandingFeatures from "../components/landing/LandingFeatures.astro";
import LandingProof from "../components/landing/LandingProof.astro";
import LandingWhy from "../components/landing/LandingWhy.astro";
import LandingPlans from "../components/landing/LandingPlans.astro";
import { LandingShowcase } from "../components/landing/LandingShowcase";
import LandingCode from "../components/landing/LandingCode.astro";
import LandingClosing from "../components/landing/LandingClosing.astro";
---

<BaseLayout
  title="Devil-UI"
  description="Devil-UI is a themeable, accessible React component library built on Base UI and Tailwind v4."
>
  <div class="isolate scroll-smooth bg-devil-canvas text-devil-default">
    <LandingNav />
    <main>
      <LandingHero />
      <LandingFeatures />
      <LandingProof />
      <LandingWhy />
      <LandingPlans />
      <LandingShowcase client:visible />
      <LandingCode />
      <LandingClosing />
    </main>
  </div>
</BaseLayout>

<style is:global>
  .landing-reveal {
    transition:
      opacity 0.6s cubic-bezier(0.22, 1, 0.36, 1),
      transform 0.6s cubic-bezier(0.22, 1, 0.36, 1);
  }
  /* Hidden only after hydration arms the animation; SSR stays visible. */
  .landing-reveal-arm {
    opacity: 0;
    transform: translateY(16px);
  }
  .landing-reveal-arm.is-visible {
    opacity: 1;
    transform: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .landing-reveal,
    .landing-reveal-arm {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>
