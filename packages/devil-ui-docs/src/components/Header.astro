---
import { ThemeToggle } from "./ThemeToggle";

declare const __DEVIL_VERSION__: string;

const devilVersion =
  typeof __DEVIL_VERSION__ !== "undefined" ? __DEVIL_VERSION__ : "dev";
---

<header
  class="sticky top-0 z-10 h-12 border-b border-devil-hairline bg-devil-canvas hidden lg:flex"
>
  <div
    class="flex min-w-0 flex-1 items-center justify-end border-r border-devil-hairline px-4"
  >
    <a
      href="https://github.com/hellwrk/devil-ui"
      target="_blank"
      rel="noopener noreferrer"
      class="font-mono text-sm text-devil-subtle transition-colors hover:text-devil-default"
    >
      devil-ui
      <span class="ml-1 rounded bg-devil-control px-1.5 py-0.5 text-xs">
        v{devilVersion}
      </span>
    </a>
  </div>

  <div class="flex w-12 shrink-0 items-center justify-center">
    <ThemeToggle client:only="react" />
  </div>
</header>
