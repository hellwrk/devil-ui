---
import { LinkButton } from "@hellwrk/devil-ui";
import { ThemeToggle } from "../ThemeToggle";

declare const __DEVIL_VERSION__: string;

const devilVersion =
  typeof __DEVIL_VERSION__ !== "undefined" ? __DEVIL_VERSION__ : "dev";

const links = [
  { label: "Why", href: "#why" },
  { label: "Components", href: "#showcase" },
  { label: "Install", href: "#start" },
  { label: "Plans", href: "#plans" },
];
---

<header
  class="sticky top-0 z-50 border-b border-devil-hairline bg-devil-canvas/85 backdrop-blur"
>
  <nav
    class="mx-auto flex h-14 w-full max-w-6xl items-center justify-between px-4 md:px-6"
  >
    <a href="#top" class="flex items-center gap-2.5" aria-label="Devil-UI home">
      <img
        src="/devil-ui-hd.png"
        alt=""
        aria-hidden="true"
        class="h-6 w-6 rounded object-contain"
      />
      <span class="text-base font-semibold">Devil-UI</span>
      <span
        class="hidden rounded bg-devil-control px-1.5 py-0.5 font-mono text-xs text-devil-subtle sm:inline"
      >
        v{devilVersion}
      </span>
    </a>

    <div class="hidden items-center gap-7 md:flex">
      {
        links.map((link) => (
          <a
            href={link.href}
            class="text-sm font-medium text-devil-subtle hover:text-devil-default"
          >
            {link.label}
          </a>
        ))
      }
    </div>

    <div class="flex items-center gap-1.5">
      <a
        href="/"
        class="hidden rounded-lg px-3 py-2 text-sm font-medium text-devil-subtle hover:text-devil-default sm:block"
      >
        Docs
      </a>
      <ThemeToggle client:only="react" />
      <LinkButton href="/installation" variant="primary" size="sm">
        Get started
      </LinkButton>
    </div>
  </nav>
</header>
