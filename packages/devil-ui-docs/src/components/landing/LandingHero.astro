---
import { Badge, LinkButton } from "@hellwrk/devil-ui";
---

<section id="top" class="px-4 pt-6 md:px-6 md:pt-8">
  <div
    class="relative mx-auto max-w-6xl overflow-hidden rounded-2xl bg-black ring-1 ring-devil-line"
  >
    <!-- full-bleed infernal sky: three copies of the same plate drift in
         opposite directions so the smoke churns around a steady glow -->
    <div
      aria-hidden="true"
      class="pointer-events-none absolute inset-0 overflow-hidden"
    >
      <img
        src="/hero/Infernal_sky_.jpeg"
        alt=""
        aria-hidden="true"
        class="hero-sky hero-sky-base h-full w-full object-cover select-none"
      />
      <img
        src="/hero/Infernal_sky_.jpeg"
        alt=""
        aria-hidden="true"
        class="hero-sky hero-sky-drift hero-sky-ring h-full w-full object-cover select-none"
      />
      <img
        src="/hero/Infernal_sky_.jpeg"
        alt=""
        aria-hidden="true"
        class="hero-sky hero-sky-drift hero-sky-low h-full w-full object-cover select-none"
      />
      <div
        class="absolute inset-0 bg-linear-to-b from-black/60 via-black/25 to-black/55"
      >
      </div>
      <div class="hero-glow"></div>
    </div>

    <div
      class="relative flex flex-col items-center justify-center px-6 py-20 text-center md:py-28"
    >
      <Badge
        variant="outline"
        className="border-white/40 bg-black/30 font-mono text-white backdrop-blur-sm"
      >
        Component library
      </Badge>
      <h1
        class="mt-6 max-w-3xl text-4xl font-semibold text-white md:text-5xl"
      >
        Everything you need to build the interface—yours to own
      </h1>
      <p class="mt-5 max-w-2xl text-base leading-relaxed text-white/85 md:text-lg">
        Themeable, accessible React components built on Base UI and Tailwind
        v4. Import what you need, own what you ship.
      </p>
      <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
        <LinkButton href="/installation" variant="primary">
          Start building
        </LinkButton>
        <a
          href="#showcase"
          class="inline-flex items-center gap-1.5 px-3 py-2 text-sm font-medium text-white/85 hover:text-white"
        >
          See components
          <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  /* Each plate is oversized (scale) so a small translate never reveals an
     edge; the movement is pure translation — no zoom. Different masks and
     durations make the ring and the low smoke churn at different speeds. */
  .hero-sky {
    position: absolute;
    inset: 0;
    transform: translate3d(0, 0, 0);
    will-change: transform;
    backface-visibility: hidden;
  }

  .hero-sky-base {
    animation: hero-sky-a 52s ease-in-out infinite alternate;
  }

  .hero-sky-drift {
    opacity: 0.85;
  }

  /* keeps the central glow clear, drifts only the surrounding smoke */
  .hero-sky-ring {
    -webkit-mask-image: radial-gradient(
      ellipse 48% 54% at 50% 44%,
      transparent 0%,
      transparent 48%,
      #000 80%
    );
    mask-image: radial-gradient(
      ellipse 48% 54% at 50% 44%,
      transparent 0%,
      transparent 48%,
      #000 80%
    );
    animation: hero-sky-b 37s ease-in-out infinite alternate;
  }

  /* keeps the lower billows, which roll the other way */
  .hero-sky-low {
    -webkit-mask-image: linear-gradient(
      to top,
      #000 0%,
      #000 26%,
      transparent 60%
    );
    mask-image: linear-gradient(to top, #000 0%, #000 26%, transparent 60%);
    animation: hero-sky-c 44s ease-in-out infinite alternate;
  }

  /* brand halo rising from the bottom of the panel, like the reference */
  .hero-glow {
    position: absolute;
    inset-inline: 0;
    bottom: -30%;
    height: 75%;
    background: radial-gradient(
      55% 65% at 50% 100%,
      color-mix(in oklab, var(--color-devil-brand) 90%, transparent) 0%,
      transparent 72%
    );
    filter: blur(8px);
  }

  @keyframes hero-sky-a {
    0% {
      transform: translate3d(-2.4%, 1.4%, 0) scale(1.16);
    }
    100% {
      transform: translate3d(2.4%, -1.8%, 0) scale(1.16);
    }
  }

  @keyframes hero-sky-b {
    0% {
      transform: translate3d(3.4%, -1.6%, 0) scale(1.22);
    }
    100% {
      transform: translate3d(-3.4%, 1.8%, 0) scale(1.22);
    }
  }

  @keyframes hero-sky-c {
    0% {
      transform: translate3d(-2.8%, 0.8%, 0) scale(1.26);
    }
    100% {
      transform: translate3d(3.2%, -1%, 0) scale(1.26);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-sky,
    .hero-sky-base,
    .hero-sky-drift,
    .hero-sky-ring,
    .hero-sky-low {
      animation: none;
      transform: scale(1.16);
    }
  }
</style>
